					line-name = "usb-hub-reset";
				};
			};
		};
	};

	opp-table0 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x03>;

		opp-24000000 {
			opp-hz = <0x00 0x16e3600>;
			opp-microvolt = "", "\f5";
			clock-latency-ns = <0x11170>;
		};

		opp-100000000 {
			opp-hz = <0x00 0x5f5e100>;
