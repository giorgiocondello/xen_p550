				#interrupt-cells = <0x01>;
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				phandle = <0x0d>;
			};
		};

		cpu@2 {
			compatible = "sifive,p550", "riscv";
			clocks = <0x01 0x1f6>;
			clock-frequency = <0x00>;
			device_type = "cpu";
			d-cache-block-size = <0x40>;
			d-cache-sets = <0x80>;
			d-cache-size = <0x8000>;
			d-tlb-sets = <0x01>;
