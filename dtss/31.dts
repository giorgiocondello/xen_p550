	aliases {
		serial0 = "/soc/serial@0x50900000";
		ethernet0 = "/soc/ethernet@50400000";
		ethernet1 = "/soc/ethernet@50410000";
	};

	chosen {
		stdout-path = "serial0:115200n8";
		xen,xen-bootargs = "com1=poll sched=null";
		
		DOMU1 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "xen,domain";
			memory = <0x00 0x40000>;
			cpus = <0x01>;
			vsbi_uart; /* remove this line if not needed */
			
			module@0x90400000 {
				compatible = "multiboot,module", "multiboot,ramdisk";
				reg = <0x90400000 0x659000>;
			};
			
			module@0x808ef000 {
				bootargs = "rw root=/dev/ram console=hvc0 earlycon=sbi earlyprintk keep_bootcon bootmem_debug debug";
				compatible = "multiboot,module", "multiboot,kernel";
				reg = <0x808ef000 0x68ff6d>;
			};
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x7f 0x80000000>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x20000000>;
			alignment = <0x00 0x1000>;
			linux,cma-default;
		};

		sprammemory@59000000 {
			no-map;
			reg = <0x00 0x59000000 0x00 0x400000>;
		};

		lpcpu@a0000000 {
			no-map;
			reg = <0x00 0xa0000000 0x00 0x100000>;
		};

		g2d_4GB_boundary_reserved_4k {
			no-map;
			reg = <0x00 0xfffff000 0x00 0x1000>;
		};
	};
};